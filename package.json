{
  "name": "clinical-guidelines",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "npm-run-all --parallel admin-api start:site",
    "start:site": "node scripts/print-lan-urls.cjs && docusaurus start --host 0.0.0.0 --port 3000",
    "start:lan": "npm-run-all --parallel admin-api start:site",
    "start:admin": "docusaurus start --host 0.0.0.0 --port 3000",
    "admin-api": "node scripts/admin-api-server.cjs",
    "stop:admin-api": "node scripts/stop-admin-api.cjs",
    "stop:servers": "node scripts/stop-admin-api.cjs && node scripts/prebuild.cjs",
    "prebuild:clean": "node scripts/prebuild.cjs",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve --host 0.0.0.0 --port 3000",
    "serve:lan": "node scripts/prebuild.cjs && npm run build && node scripts/serve-lan.cjs",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "import-manual": "python scripts/pdf-to-docs.py --clean",
    "typecheck": "tsc",
    "build:mobile": "npm run build && npx cap sync",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "setup:admin": "node scripts/setup-admin-config.cjs",
    "setup:wamp": "node scripts/setup-wamp.cjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.1",
    "@docusaurus/faster": "3.10.1",
    "@docusaurus/preset-classic": "3.10.1",
    "@easyops-cn/docusaurus-search-local": "^0.55.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@docusaurus/module-type-aliases": "3.10.1",
    "@docusaurus/plugin-pwa": "^3.10.1",
    "@docusaurus/tsconfig": "3.10.1",
    "@docusaurus/types": "3.10.1",
    "@types/react": "^19.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "~6.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
